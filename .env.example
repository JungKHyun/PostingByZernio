# ChatGPT Desktop의 Zernio MCP에 사용한 것과 같은 Zernio API 키
ZERNIO_API_KEY=

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 단일 관리자 계정은 admin으로 고정됩니다.
# 초기 비밀번호는 첫 로그인 직후 반드시 변경됩니다.
INITIAL_ADMIN_PASSWORD=

# 8자 이상의 임의 문자열. 보안을 위해 32자 이상을 권장합니다.
SESSION_SECRET=

# Vercel 배포 시 Upstash Redis 연동이 필요합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 로컬 서버 포트
PORT=8787
